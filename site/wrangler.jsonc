// Cloudflare Workers: static assets (dist/) plus a small script for /api/* (the live preview).
// Workers Builds runs `npm run build`, then `npx wrangler deploy` uploads dist/ and worker/.
{
  "name": "underset",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only the API runs the script; every page is served straight from the assets.
    "run_worker_first": ["/api/*"]
  },
  // One shared queue so the whole site makes at most one request to 1001Tracklists every 8 s.
  "durable_objects": {
    "bindings": [{ "name": "PACER", "class_name": "Pacer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Pacer"] }],
  "observability": { "enabled": true }
}
